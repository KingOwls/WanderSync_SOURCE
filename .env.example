POSTGRES_DB=wandersync
POSTGRES_USER=wandersync
POSTGRES_PASSWORD=wandersync_dev_password
DATABASE_URL=postgresql://wandersync:wandersync_dev_password@postgres:5432/wandersync
REDIS_URL=redis://redis:6379/0
COOKIE_SECURE=false
COOKIE_NAME=wander_session
FRONTEND_ORIGIN=http://localhost:8080
ALLOW_FAILURE_INJECTION=true
GRAPHQL_URL=http://localhost:8000/graphql

# Real public web scraping. Tourist data is never generated locally.
SCRAPE_SNAPSHOT_ROOT=/data/snapshots
SCRAPE_CACHE_MINUTES=30
SCRAPE_STALE_MAX_HOURS=24
SCRAPE_MIN_INTERVAL_SECONDS=90
SCRAPE_MAX_INTERVAL_SECONDS=180
# Must remain 1: acquisition is intentionally serialized per source.
SCRAPE_MAX_CONCURRENCY_PER_SOURCE=1
SCRAPE_NAVIGATION_TIMEOUT_SECONDS=45
SCRAPE_RETRY_LIMIT=2
SCRAPE_ENABLED_SOURCES=clicair,satena,jetsmart,wingo,ghl_porton_medellin,alkilautos_national_medellin
INGEST_INTERVAL_SECONDS=900
INGEST_RUN_ONCE=false

TARGET_OFFERS_PER_DIRECTION=10
MAX_ROUTE_CONCURRENCY_PER_SOURCE=2
